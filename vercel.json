{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/v2/work/framewise", "destination": "/v2/work/", "permanent": true },
    { "source": "/v2/work/threadmark", "destination": "/v2/work/", "permanent": true },
    { "source": "/v2/work/cartpilot", "destination": "/v2/work/", "permanent": true },
    { "source": "/v2/work/marginguard", "destination": "/v2/work/", "permanent": true },
    { "source": "/v2/ecommerce", "destination": "/v2/storecraft", "permanent": true },
    { "source": "/v2/offers/revenue-leak-audit", "destination": "/v2/storecraft/revenue-leak-audit", "permanent": true },
    { "source": "/v2/offers/ai-support-concierge", "destination": "/v2/storecraft/ai-support-concierge", "permanent": true },
    { "source": "/v2/offers/ai-ops-dashboard", "destination": "/v2/storecraft/ai-ops-dashboard", "permanent": true },
    { "source": "/v2/offers/retention-automation", "destination": "/v2/storecraft/retention-automation", "permanent": true },
    { "source": "/v2/offers/inventory-intelligence", "destination": "/v2/storecraft/inventory-intelligence", "permanent": true },
    { "source": "/v2/offers/returns-automation", "destination": "/v2/storecraft/returns-automation", "permanent": true },
    { "source": "/v2/offers/custom-automation", "destination": "/v2/storecraft/custom-automation", "permanent": true }
  ],
  "functions": {
    "api/chat.py": {
      "includeFiles": "knowledge/*.md",
      "maxDuration": 60
    },
    "api/feedback.py": {
      "maxDuration": 15
    },
    "api/referrals.py": {
      "maxDuration": 30
    },
    "api/cal/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
